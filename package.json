{
  "name": "fundsindia-learning-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite build -c vite.learner.config.ts --watch",
    "build": "vite build -c vite.learner.config.ts && vite build -c vite.head.config.ts && vite build -c vite.admin.config.ts",
    "seed:build": "node seed/build-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply fundsindia-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply fundsindia-hub --remote",
    "db:seed:local": "node seed/apply.mjs --local",
    "db:seed:remote": "node seed/apply.mjs --remote",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  }
}
